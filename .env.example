# Copy to `.env` for local development (`make env` generates one with random secrets).
# Production values belong in `.env.prod` on the server only — never commit real credentials.

# --- Django ---
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8010,http://127.0.0.1:8010
DJANGO_LOG_LEVEL=INFO
DJANGO_DEBUG_TOOLBAR=0

# --- Database (MySQL 8) ---
DB_ENGINE=django.db.backends.mysql
DB_NAME=alijahon_dev
DB_USER=alijahon
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# Host/port used when running manage.py on the host; inside Docker compose overrides them to db:3306
DB_HOST=127.0.0.1
DB_PORT=3317

# --- Cache (optional; falls back to in-memory cache) ---
REDIS_URL=

# --- Docker host ports ---
WEB_PORT=8010
DB_HOST_PORT=3317

# --- Development seed accounts (used by `manage.py seed_dev_data`; dev only) ---
SEED_ADMIN_PHONE=900000001
SEED_ADMIN_PASSWORD=change-me
SEED_CUSTOMER_PHONE=900000002
SEED_CUSTOMER_PASSWORD=change-me
SEED_STAFF_PASSWORD=change-me

# --- Storefront ---
STORE_SUPPORT_PHONE=
